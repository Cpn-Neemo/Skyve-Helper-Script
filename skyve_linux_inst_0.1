#!/usr/bin/env bash
#Welcome to the Skyve Linux Install Helper Script. Feel free to modify this script to work with whatever distribution you use etc..
#No resposibility is taken by me for your saved games, PC, or life. Hope this helps more linux users use the awesome Skyve tool for CSII.
#Cpn-Neemo

set -euo pipefail          # Fail fast on errors / undefined vars

# -------------------------------------------------
# Simple logger (adds a HH:MM:SS timestamp)
# -------------------------------------------------
log() {
    printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*"
}

#Welcome message and cautions
#CODE GOES HERE

# --------------------------------------------------------------
#  Question‑helper functions
# --------------------------------------------------------------

# Utility: print a coloured prompt (green = info, red = warning)
info()  { printf "\e[32m▶ %s\e[0m\n" "$*"; }
warn()  { printf "\e[31m⚠ %s\e[0m\n" "$*"; }

# Generic yes/no reader -----------------------------------------
# Returns 0 for yes, 1 for no.
ask_yes_no() {
    local prompt="$1"
    local answer
    while true; do
        read -rp "$(printf "\e[36m%s [y/n]: \e[0m" "$prompt")" answer
        case "${answer,,}" in   # lower‑case
            y|yes)  return 0 ;;
            n|no)   return 1 ;;
            *)      warn "Please answer 'y' or 'n'." ;;
        esac
    done
}

# ----------------------------------------------------------------
# 1️⃣  Have you backed up your game?
# ----------------------------------------------------------------
check_backup_game() {
    info "Have you backed up your game saves?"
    if ask_yes_no "Did you already copy the save files somewhere safe?"; then
        info "Great – moving on."
        return 0
    else
        warn "Please back up your saves before continuing."
        echo "Typical save locations for Cities Skylines 2:"
        echo "  • Linux (Steam):   \$HOME/.local/share/Steam/steamapps/compatdata/<APPID>/pfx/drive_c/users/steamuser/My Documents/Cities_Skylines_2"
        echo "  • Windows (non‑Steam): %USERPROFILE%\\Documents\\Cities_Skylines_2"
        echo "Copy the whole folder to another location (USB drive, another folder, cloud sync …) and re‑run the script when done."
        exit 1   # stop the script until the user backs up
    fi
}

# ----------------------------------------------------------------
# 2️⃣  Have you installed Skyve from the in‑game mods menu?
# ----------------------------------------------------------------
check_skyve_installed() {
    info "Have you installed Skyve from the in‑game mods menu?"
    if ask_yes_no "Is Skyve already present in your Mods list?"; then
        info "Skyve is installed – proceeding."
        return 0
    else
        warn "Please install Skyve via the in‑game Mod Manager first."
        echo "Steps:"
        echo "  1. Launch Cities Skylines 2."
        echo "  2. Open the ‘Mods’ tab."
        echo "  3. Click ‘Browse Workshop’ and search for “Skyve”."
        echo "  4. Subscribe / Install the mod and wait for it to finish."
        echo "  5. Return to this terminal and run the script again."
        exit 1
    fi
}

# ----------------------------------------------------------------
# 3️⃣  Again, have you backed up your saves? (second safety check)
# ----------------------------------------------------------------
double_check_backup() {
    info "One more safety check – have you backed up your saves?"
    if ask_yes_no "Are you sure the backup is still up‑to‑date?"; then
        info "Backup confirmed – moving forward."
        return 0
    else
        warn "Please make a fresh backup now. The script will stop."
        echo "Refer to the paths shown in the first backup reminder."
        exit 1
    fi
}

# ----------------------------------------------------------------
# 4️⃣  Where is Steam installed? (detect common defaults)
# ----------------------------------------------------------------
detect_steam_dir() {
    local candidates=(
        "$HOME/.steam/steam"                # typical for most distros
        "$HOME/.local/share/Steam"          # flatpak/runtime style
        "/usr/lib/steam"                    # Arch official package
        "/snap/steam/common/.steam/steam"   # Snap package
    )
    local dir

    for dir in "${candidates[@]}"; do
        if [[ -d "$dir" && -x "$dir/steam" ]]; then
            STEAM_DIR="$dir"
            info "Detected Steam installation at: $STEAM_DIR"
            return 0
        fi
    done

    # If we reach here nothing was auto‑detected
    warn "Could not automatically locate Steam."
    read -rp "$(printf "\e[36mEnter the full path to your Steam folder: \e[0m")" STEAM_DIR
    if [[ -d "$STEAM_DIR" && -x "$STEAM_DIR/steam" ]]; then
        info "Using user‑provided Steam directory: $STEAM_DIR"
        return 0
    else
        warn "That path does not look like a valid Steam installation."
        exit 1
    fi
}

# -------------------------------------------------
#Set STEAM_ID variable for CSII
# -------------------------------------------------
STEAM_ID=949230

# -------------------------------------------------
# Ensure the Steam prefix exists before proceeding
# -------------------------------------------------
if [[ ! -d "$STEAM_ID" ]]; then
    echo "ERROR: Steam prefix '$STEAM_ID' not found – Is CSII Installed?"
    exit 1
fi

#Check if protontricks installed 
#CODE goes here

#Where is CSII installed? Enter for default
#CODE goes here

#Where is skyve installed? Enter for default (using the steam directory above as referance)
#  `~/.local/share/Steam/steamapps/compatdata/949230/pfx/drive_c/Program Files (x86)/Skyve CS-II` 
#SKYVE_PATH="steamapps/compatdata/$STEAM_ID/pfx/drive_c/Program Files (x86)/Skyve CS-II/Skyve.exe"
#CODE goes here

# -------------------------------------------------
#Install Dependencies
# -------------------------------------------------
# Paths (STEAM_ID is defined earlier)
# -------------------------------------------------
GAC_DIR="$STEAM_DIR/steamapps/compatdata/$STEAM_ID/pfx/drive_c/windows/Microsoft.NET/assembly/GAC_MSIL"
DLL_FILE="$GAC_DIR/Microsoft.Windows.Compatibility.dll"

# -------------------------------------------------
# Helper: check whether .NET 4.8 is present
# -------------------------------------------------
net48_installed() {
    [[ -d "$GAC_DIR" ]] && \
    [[ -f "$DLL_FILE" ]] && \
    grep -a -q "v4\.8" "$DLL_FILE"
}

# -------------------------------------------------
# Main flow
# -------------------------------------------------
if net48_installed; then
    log ".NET 4.8 is already installed – continuing."
else
    log "Now installing .NET 4.8 dependency…"
    yes | protontricks "$STEAM_ID" -q dotnet48 &
    dotnet_pid=$!
    wait "$dotnet_pid"

    # Verify the install succeeded
    if net48_installed; then
        log ".NET 4.8 installed successfully – continuing."
    else
        log "ERROR: .NET 4.8 installation failed – quitting."
        exit 1
    fi
fi

#may need to install fonts here, not sure until testing

#Do you want to launch skyve after the script finishes? Yes run below on exit, no skip over
protontricks-launch --appid $STEAM_ID  "$STEAM_DIR/$SKYVE_PATH"

#Do you want a desktop file created for Skyve protontricks-launcher
# ------------------------------------------------------------------
# Assumptions (already defined earlier in script):
#   STEAM_ID      – Steam AppID of the game
#   STEAM_DIR     – Root directory of the Steam library (e.g. "$HOME/.steam/steam")
#   SKYVE_PATH    – Relative path inside the Steam library to the Skyve binary
# ------------------------------------------------------------------

# Full path to the executable that will be launched
EXECUTABLE="${STEAM_DIR}/${SKYVE_PATH}"

# ------------------------------------------------------------------
# Choose an icon
# ------------------------------------------------------------------
# 1️⃣  Try an icon that sits next to the executable (same basename, .png)
ICON_CANDIDATE="${EXECUTABLE%.*}.png"

# 2️⃣  If that file does not exist, fall back to a generic icon you ship
#      (replace the path with wherever you keep a fallback icon)
FALLBACK_ICON="${HOME}/.local/share/icons/skyve-fallback.png"

# Resolve which icon to use
if [[ -f "${ICON_CANDIDATE}" ]]; then
    ICON_PATH="${ICON_CANDIDATE}"
else
    ICON_PATH="${FALLBACK_ICON}"
fi

# ------------------------------------------------------------------
# Destination for the .desktop file (per‑user, no sudo needed)
# ------------------------------------------------------------------
DESKTOP_DIR="${HOME}/.local/share/applications"
mkdir -p "${DESKTOP_DIR}"

DESKTOP_FILE="${DESKTOP_DIR}/skyve.desktop"

# ------------------------------------------------------------------
# Write the .desktop entry
# ------------------------------------------------------------------
cat > "${DESKTOP_FILE}" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=Skyve
Comment=Skyve Mod Manager for Cities Skylines 2 (installed with Neemo's Skyve installer script)
Exec=protontricks-launch --appid ${STEAM_ID} "${EXECUTABLE}"
Icon=${ICON_PATH}
Terminal=false
StartupNotify=true
Categories=Game;Simulation;
EOF

# ------------------------------------------------------------------
# Make sure the file is readable/executable by the desktop environment
# ------------------------------------------------------------------
chmod 644 "${DESKTOP_FILE}"

# Optional: force the desktop environment to refresh its cache
# (most DEs pick up new .desktop files automatically)
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database "${DESKTOP_DIR}"
fi

echo "✅ Desktop launcher created at: ${DESKTOP_FILE}"

#Finished script, remember not to use continue from inside CSII and launch game from within skyve.
#Make backups of your saves. Auto backs do not always work with Skyve in Linux make sure you check regularly.
#Share this script if it helped you.
